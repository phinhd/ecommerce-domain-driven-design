{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "ECommerceApi",
    "Audience": "ECommerceApp",
    "DurationInMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Seed": {
    "SampleData": false
  },
  "RateLimiting": {
    "AuthPermitLimit": 20
  },
  "AdminSeedSettings": {
    "Email": "",
    "Password": ""
  }
}
